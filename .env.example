# Postgres connection string. If unset, the site runs in read-only demo mode
# against seed data (admin edits and order submissions won't persist).
# Works with Vercel Postgres, Neon, Supabase, or any standard Postgres.
DATABASE_URL=

# Admin panel password and session-signing secret. Required to use /admin.
# Generate the secret with: openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Stripe test-mode (sandbox) keys — Dashboard > Developers > API keys.
# Without these, checkout shows a clear "payments not configured" state
# instead of erroring.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional outbound hook, fired after a successful checkout.session.completed
# with the order payload. Leave empty until a Zap exists — an empty value is
# skipped silently, so wiring Zapier up later needs no code change.
ZAPIER_WEBHOOK_URL=

# Public site URL, used for canonical links, sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
